{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "App.tsx", "index.js", "svg.d.ts"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    ".expo",
    "dist",
    "web-build",
    "@react-native/typescript-config/tsconfig.json"
  ],
  "extends": "expo/tsconfig.base"
}
